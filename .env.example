# ============================================================
# Copia este archivo y rellénalo:
#   Laragon / local ...... cp .env.example .env
#   Docker producción .... cp .env.example .env.production
# NUNCA subas el .env real al repositorio (ya está en .gitignore).
# ============================================================

APP_NAME="Finanzas Personales"
APP_ENV=development            # development | production
APP_DEBUG=true                 # false en producción (no muestra errores en pantalla)
APP_URL=http://localhost:8080  # URL pública, sin barra final. La usan los correos.
APP_BASE_PATH=auto             # auto = se detecta solo. Si la app vive en una subcarpeta
                               # o detrás de un proxy que quita un prefijo: /subcarpeta
APP_TRUST_PROXY=false          # true en producción detrás de un proxy con HTTPS
APP_TIMEZONE=America/Bogota
APP_LOCALE=es_CO
APP_CURRENCY=COP
APP_PORT=8080                  # puerto donde Docker publica la app

# Correo (recuperar contraseña). Gmail: usa una "contraseña de aplicación" de
# 16 caracteres (requiere verificación en 2 pasos), NO la contraseña normal.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Finanzas Personales"

# Base de datos.
#   Laragon: DB_HOST=127.0.0.1, DB_USER=root, DB_PASS= (vacío)
#   Docker:  DB_HOST lo fija docker-compose (es el servicio "db"); en producción
#            DB_USER, DB_PASS y DB_ROOT_PASSWORD son obligatorios y NO pueden ser root/vacíos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finanzas_personales
DB_USER=root
DB_PASS=
DB_ROOT_PASSWORD=